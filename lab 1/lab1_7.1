import numpy as np
import ugradio.sdr

fs = 1_000_000
N  = 16384

sdr = ugradio.sdr.SDR(sample_rate=fs)

# flush stale buffer
_ = sdr.read_samples(4096)

# capture IF
x = sdr.read_samples(N).astype(float)

np.savez("dsb_IF_RF9p8_LO10_fs1MHz.npz", data=x, sample_rate=fs)

print("saved", x.shape)




import matplotlib.pyplot as plt

t = np.arange(N)/fs
plt.figure()
plt.plot(t[:2000], x[:2000])
plt.xlabel("Time (s)")
plt.ylabel("Voltage (arb)")
plt.title("IF time series (should look sinusoidal)")
plt.show()
